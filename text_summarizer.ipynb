      "source": [
        "import re # regex\n",
        "def clean_data(text):\n",
        "    text = re.sub(r\"\\r\\n\", \" \", text) # lines\n",
        "    text = re.sub(r\"\\s+\", \" \", text) # spaces\n",
        "    text = re.sub(r\"<.*?>\", \" \", text) # all html tags\n",
        "    text = text.strip().lower()\n",
        "    return text"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "id": "ac8926a6-6572-4c31-890e-7c1e450295c7",
      "metadata": {
        "id": "ac8926a6-6572-4c31-890e-7c1e450295c7"
      },
      "outputs": [],
      "source": [
        "train_data[\"dialogue\"] = train_data[\"dialogue\"].apply(clean_data)\n",
        "train_data[\"summary\"] = train_data[\"summary\"].apply(clean_data)\n",
        "\n",
        "val_data[\"dialogue\"] = val_data[\"dialogue\"].apply(clean_data)\n",
        "val_data[\"dialogue\"] = val_data[\"dialogue\"].apply(clean_data)"
      ]
    },
